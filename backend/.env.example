# Copie para .env (desenvolvimento local sem Docker) ou use o .env da raiz com docker-compose.prod.yml

# --- Obrigatorias em producao ---
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tcc_erp

# --- Primeiro administrador (criado se nao existir; senha nunca e sobrescrita) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

