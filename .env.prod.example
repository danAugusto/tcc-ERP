# Copie para .env na raiz do projeto e ajuste. NUNCA versione o .env.

# --- Obrigatorias ---
SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
POSTGRES_PASSWORD=     # senha forte do banco
ADMIN_USERNAME=admin
ADMIN_PASSWORD=        # minimo 8 caracteres; usada somente na criacao do 1o administrador

# --- Rede ---
# Em PRODUCAO use HTTPS (veja abaixo): o padrao HTTP e so para homologacao em rede local.
# Homologacao em HTTP puro (VM/LAN): mantenha os padroes e acesse http://IP-DA-VM
ALLOWED_HOSTS=localhost,127.0.0.1   # inclua o IP/dominio da VM, ex.: localhost,192.168.0.50
SITE_ADDRESS=:80
TLS_DIRECTIVE=
USE_HTTPS=False
CSRF_TRUSTED_ORIGINS=               # ex.: http://192.168.0.50

# HTTPS com certificado interno do Caddy (habilita PWA/service worker em rede local):
#   SITE_ADDRESS=https://192.168.0.50
#   TLS_DIRECTIVE=tls internal
#   USE_HTTPS=True
#   CSRF_TRUSTED_ORIGINS=https://192.168.0.50
# HTTPS com dominio real: SITE_ADDRESS=erp.exemplo.com, TLS_DIRECTIVE vazio, portas 80/443 abertas.

# --- Opcionais ---
# POSTGRES_USER=erp
# POSTGRES_DB=tcc_erp
# GUNICORN_WORKERS=3
# HTTP_PORT=80
# HTTPS_PORT=443
# TIME_ZONE=America/Sao_Paulo
